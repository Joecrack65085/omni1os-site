# Same Supabase project as the main Omni1OS school-system app —
# schools/platform_admins/school_payment_settings all live there too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Used by every /api/admin/*
# route and the registration route to bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=
